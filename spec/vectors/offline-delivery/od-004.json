{
  "id": "od-004",
  "kind": "reachability-verdict",
  "description": "hourly_wake outside the five-minute UTC window rejects with retryAfterSec.",
  "requires": [
    "reachability",
    "hourly-wake"
  ],
  "config": {
    "mode": "hourly_wake",
    "wakeSeed": "wake-vector-seed",
    "forceAlwaysOn": false
  },
  "now": "2026-01-15T12:41:00.000Z",
  "expect": {
    "accept": false,
    "error": "agent_asleep",
    "retryAfterSecMin": 1
  }
}
