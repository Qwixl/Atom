# Agent backend / local control-plane stub (optional)

# Local hosted-signup stub (`pnpm dev:hosting`)
# HOSTED_STUB_AGENT_URL=http://127.0.0.1:5301
# HOSTED_STUB_AGENT_TOKEN=dev-stub-token
# ATOM_SHELL_ORIGINS=http://127.0.0.1:5200,http://localhost:5200
# ATOM_PROVISION_SECRET=

# Supabase — control plane only (never ship service role to the browser)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Supabase — shell (publishable key, safe in browser)
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=
